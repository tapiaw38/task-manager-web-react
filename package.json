{
    "name": "task-manager-web-react",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cover": "vitest run --coverage",
        "typecheck": "tsc -b",
        "docs": "npx -y docsify-cli serve ./docs --port 3002"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@tanstack/react-virtual": "^3.14.13",
        "dayjs": "^1.11.23",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^5.0.1",
        "docsify-cli": "^4.4.4",
        "jsdom": "^27.0.1",
        "oxlint": "^1.81.0",
        "prettier": "^3.9.9",
        "typescript": "~6.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
